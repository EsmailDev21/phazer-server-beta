# Required — no fallback, app refuses to boot if unset.
DATABASE_URL="postgresql://user:password@localhost:5432/appdb?schema=public"

# Used by `npm run test:integration` only. Points at the disposable Postgres
# started by `npm run db:test:up` (docker-compose service "test-db", port
# 5433) - never your dev database. Every test truncates every table.
TEST_DATABASE_URL="postgresql://user:password@localhost:5433/appdb_test?schema=public"

# Used by the real-Redis unit specs (src/redis/redis.real.spec.ts). Any reachable
# Redis works (`docker compose up -d redis`); the specs only use throwaway keys
# and never FLUSH. Unset locally = those specs are skipped; unset in CI = fail.
# TEST_REDIS_URL="redis://localhost:6379"
# Only used by `npm run db:verify` (CI supplies its own). Defaults to the compose Postgres.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/appdb_shadow?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"

# Optional
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# CORS — comma-separated list of allowed origins. Required whenever the
# frontend runs on a different origin (different port counts as different
# origin) than the API, which is normal in dev.
CORS_ORIGIN="http://localhost:3001"

# Cookie SameSite policy for the auth cookies (accessToken/refreshToken).
# 'lax'  — same-site or same-origin-via-reverse-proxy deployments (default).
# 'none' — genuinely cross-origin deployments (separate domains). Forces
#          secure:true regardless of NODE_ENV, since SameSite=None requires
#          HTTPS by spec.
COOKIE_SAME_SITE=lax

# Google OAuth — optional. If either is unset, the Google strategy is not
# registered and /auth/google + /auth/google/callback will 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Object storage — S3-compatible (AWS S3, Cloudflare R2, or self-hosted
# MinIO). Omit S3_ENDPOINT entirely to use real AWS S3.
S3_BUCKET=app-attachments
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local MinIO from docker-compose.yml (`docker compose up -d minio`; console on
# http://localhost:9001). Create the bucket named in S3_BUCKET once, then use:
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Billing — payment provider credentials. Stripe is kept but never
# auto-selected for new checkouts (see ProviderRouterService) unless
# ENABLE_STRIPE_AUTO_SELECT=true.
ENABLE_STRIPE_AUTO_SELECT=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price id per PlanKey that should be purchasable via Stripe:
# STRIPE_PRICE_ID_PRO_PERSONAL=
# STRIPE_PRICE_ID_STARTER_ORG=
# STRIPE_PRICE_ID_PROFESSIONAL_ORG=
# STRIPE_PRICE_ID_ENTERPRISE_ORG=

# MOR (merchant of record) — Lemon Squeezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# One variant id per PlanKey:
# LEMONSQUEEZY_VARIANT_ID_PRO_PERSONAL=
# LEMONSQUEEZY_VARIANT_ID_STARTER_ORG=
# LEMONSQUEEZY_VARIANT_ID_PROFESSIONAL_ORG=
# LEMONSQUEEZY_VARIANT_ID_ENTERPRISE_ORG=

# Tunisia gateway — Paymee. TND amounts (not cents — confirm Paymee's
# actual expected unit before production use).
PAYMEE_API_KEY=
# PAYMEE_AMOUNT_TND_PRO_PERSONAL=
# PAYMEE_AMOUNT_TND_STARTER_ORG=
# PAYMEE_AMOUNT_TND_PROFESSIONAL_ORG=
# PAYMEE_AMOUNT_TND_ENTERPRISE_ORG=

# --- Integrations / import / templates / marketplace rollout ---------------
# NOT READ BY THE APP YET. These are reserved so the names are settled; each is
# wired up by the step named beside it (see docs/design/IMPLEMENTATION.md).
# How flags behave (404 when off, boot-time prerequisites) is docs/design/adr/0002.

# Redis (docker compose service "redis"). Step 0.1. Will be required ONLY when a
# Redis-backed feature flag is on, so environments without Redis keep booting.
# REDIS_URL="redis://localhost:6379"

# Feature flags - env-driven, default off (only `true` or `1` turns one on). A
# disabled feature's controllers return 404 and its workers do not start.
# MARKETPLACE requires TEMPLATES; INTEGRATIONS and IMPORTS require REDIS_URL.
# FEATURE_WORKFLOW=false
# FEATURE_INTEGRATIONS=false
# FEATURE_IMPORTS=false
# FEATURE_TEMPLATES=false
# FEATURE_MARKETPLACE=false

# TokenVault (step 0.5) - AES-256-GCM secret encryption, key ring for
# rotation. NOT READ BY ANY CALLER YET - Phase 2's IntegrationCredential
# (OAuth tokens) is the first real one; the module and validation are
# live starting this step regardless, same as Redis/queue were before
# their first consumer existed. Both unset = TokenVaultService.configured
# is false and encrypt() throws until it's set - fine while nothing calls it.
#
# TOKEN_VAULT_KEYS: every key still allowed to DECRYPT, "kid:base64key"
# pairs, comma-separated. Each key must be exactly 32 raw bytes
# (base64-encoded) - generate one with: openssl rand -base64 32
# TOKEN_VAULT_CURRENT_KID: the ONE key id new encrypt() calls use. Keep an
# old kid in TOKEN_VAULT_KEYS after rotating so existing ciphertext stays
# decryptable; TokenVaultService.reencrypt() migrates a row onto the
# current key so the old one can eventually be dropped from the ring.
# TOKEN_VAULT_KEYS="k1:REPLACE_WITH_output_of_openssl_rand_-base64_32"
# TOKEN_VAULT_CURRENT_KID="k1"

# Automations - if/else and loop limits (optional; read on every use, restart to change).
# A value that is not a whole number from 1 up to the hard ceiling is IGNORED and the default applies.
# AUTOMATION_MAX_IF_DEPTH=3          # IFs inside one another (default 3, hard ceiling 5)
# AUTOMATION_MAX_TOTAL_ACTIONS=30    # every action in one rule, branches included (default 30, hard ceiling 100)
# AUTOMATION_MAX_FOR_EACH_ITEMS=100  # tasks one FOR_EACH may select; more and it does nothing and fails (default 100, hard ceiling 1000)
# AUTOMATION_MAX_LOOP_STEPS_PER_RUN=500 # loops started + tasks processed in one run: what bounds a loop inside a loop (default 500, hard ceiling 5000)
# AUTOMATION_MAX_WAIT_DAYS=30            # the longest a WAIT may last (default 30, hard ceiling 365)
# AUTOMATION_MAX_PENDING_WAITS=5000      # waits one workspace may have pending (default 5000, hard ceiling 100000)
# AUTOMATION_MAX_CALL_DEPTH=3            # rules calling rules (RUN_RULE): how deep (default 3, hard ceiling 5)
# AUTOMATION_MAX_NOTIFY_RECIPIENTS=50    # people one NOTIFY may reach (default 50, hard ceiling 500)
# AUTOMATION_MAX_ACTIONS_PER_RUN=300 # actions one run may EXECUTE, loops included (default 300, hard ceiling 2000)

# Running saved views / loop selection (optional; same rules: bad values ignored, never above the ceiling).
# VIEW_RUN_MAX_PAGE=100              # tasks per page (default 100, hard ceiling 500)
# VIEW_RUN_MAX_SCAN=5000             # rows looked at per call (default 5000, hard ceiling 50000)

# ---- Integrations (step 2.1, ADR-0009). Needs FEATURE_INTEGRATIONS=true, REDIS_URL, TOKEN_VAULT_*.
# Public base URL of THIS API as the providers see it; callbacks are {API_PUBLIC_URL}/integrations/<provider>/callback
# API_PUBLIC_URL="http://localhost:3000"
# Discord: Developer Portal -> OAuth2 (add the redirect above). DISCORD_BOT_TOKEN is only used to leave the server on disconnect.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# Application public key (hex, 64 chars) from the Developer Portal -> General Information. REQUIRED for slash commands: without it every
# interaction is rejected with 401. Set the portal's "Interactions Endpoint URL" to {API_PUBLIC_URL}/integrations/discord/interactions
# DISCORD_PUBLIC_KEY=
# Slack: api.slack.com/apps -> OAuth & Permissions (add the redirect above).
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Signing secret (Basic Information). REQUIRED for /task, the message shortcut, buttons and link unfurls: without it every Slack
# request is rejected with 401. Easiest setup: create the app from docs/slack-app-manifest.json (it sets all three request URLs).
# SLACK_SIGNING_SECRET=
# SLACK_SIGNING_SECRET_PREVIOUS=   # step 2.7: only DURING a rotation (accepted in addition to the one above); remove afterwards
# GitHub App: enable "Request user authorization (OAuth) during installation"; Callback URL = the redirect above;
# Setup URL = the same, with "Redirect on update" on. Private key PEM may use literal \n.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# Step 2.6: the App's "Webhook secret" (>= 16 chars). Without it EVERY webhook is rejected with 401. Webhook URL: {API_PUBLIC_URL}/integrations/github/webhook (content type application/json)
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET_PREVIOUS=  # step 2.7: only DURING a rotation; remove afterwards
# Linear (step 4.5): linear.app/settings/api -> OAuth2 applications (add the redirect above; scope `read` is all the importer asks for).
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# ClickUp (step 4.7): an OAuth app made in ClickUp > Settings > Apps (workspace owner / admin). Redirect URL = the connect callback.
# CLICKUP_CLIENT_ID=
# CLICKUP_CLIENT_SECRET=
# Requests a minute spent on one ClickUp token (default 90, under the 100 of Free / Unlimited / Business; raise it on Business Plus / Enterprise).
# CLICKUP_REQUESTS_PER_MINUTE=90
# Jira Cloud (step 4.8): an OAuth 2.0 (3LO) app made at developer.atlassian.com/console/myapps, classic scopes read:jira-work read:jira-user + offline_access.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# Asana (step 4.10): an OAuth app made at app.asana.com/0/my-apps (redirect URL = the connect callback). Register the read scopes
# workspaces:read teams:read projects:read tasks:read users:read stories:read attachments:read custom_fields:read tags:read
# (or turn on "Full permissions" and set ASANA_SCOPES=default; Asana refuses a scoped request from a full-permissions app).
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
# ASANA_SCOPES=
# Requests a minute spent on one Asana token (default 120, under the 150 of a Free domain; a paid domain allows 1,500).
# ASANA_REQUESTS_PER_MINUTE=120
# monday.com (step 4.11): an app made in the monday Developer Center. TWO OAuth flows exist: "legacy" (tokens never expire, no refresh,
# no PKCE) and "2.1" (PKCE, ~24h access tokens, rotating refresh tokens, revocation; the toggle is per app VERSION in the console, and this
# setting must match it). Register the read scopes
# me:read account:read boards:read workspaces:read users:read updates:read assets:read
# MONDAY_CLIENT_ID=
# MONDAY_CLIENT_SECRET=
# MONDAY_OAUTH_FLOW=2.1
# MONDAY_SCOPES=
# The API version is ALWAYS sent (a missing header floats to whatever is Current). Move it deliberately.
# MONDAY_API_VERSION=2026-07
# Requests a minute spent on one monday token (default 600; the smallest plan allows 1,000) and the complexity-aware pacing (default on).
# MONDAY_REQUESTS_PER_MINUTE=600
# MONDAY_COMPLEXITY_PACING=true
# Extra hosts a file download may come from, if the logs show a refusal for a real monday storage host ("host" or ".suffix", comma separated).
# MONDAY_FILE_HOSTS=
# Notion (step 4.12): a PUBLIC connection made in the Notion developer portal (redirect URL = the connect callback). Give it the capabilities
# "read content", "read comments" and "read user information incl. email addresses" (without the last one people are matched by name only).
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# The API version is ALWAYS sent. 2026-03-11 is the one with the page-markdown endpoint the importer relies on.
# NOTION_API_VERSION=2026-03-11
# Notion sends no expires_in: with a refresh token the access token is treated as living this many seconds (0 = never refresh).
# NOTION_TOKEN_TTL_SECONDS=3600
# Requests a second per token (Notion allows an average of 3; default 2.5).
# NOTION_REQUESTS_PER_SECOND=2.5
# Extra hosts a file download may come from, if the logs show a refusal for a real Notion storage host ("host" or ".suffix", comma separated).
# NOTION_FILE_HOSTS=
# Step 4.7b: where the API is reachable FROM THE BROWSER, put in front of /files/<id>/content in imported text (e.g. /api). Default: none.
# FILES_CONTENT_URL_PREFIX=

# ---- Notifications (step 2.3, ADR-0011)
# Max messages per channel subscription per minute; the excess is recorded as skipped (default 20).
# NOTIFY_MAX_PER_MINUTE=20
# Deep link in messages. Default {FRONTEND_URL}/tasks/{KEY-N}; placeholders {key} and {id}.
# TASK_URL_TEMPLATE="https://app.example.com/t/{key}"

# ---- Hardening (step 2.7, ADR-0015) ----
# METRICS_TOKEN: bearer token for GET /metrics (Prometheus). Unset or shorter than 16 chars = the route answers 404.
#   Generate: openssl rand -base64 32     Scrape config: authorization: { type: Bearer, credentials: <token> }
# METRICS_TOKEN=
# PROVIDER_HTTP_TUNING: JSON per-host overrides of the outbound limiter, "*" = defaults. Built-in profiles: discord.com, slack.com,
#   api.github.com. Bad entries are ignored with a boot warning. Options: bucketCapacity, refillPerSecond, maxInlineWaitMs,
#   maxRetries, breakerThreshold, breakerOpenMs, timeoutMs, backoffBaseMs, backoffMaxMs.
# PROVIDER_HTTP_TUNING={"slack.com":{"refillPerSecond":2}}
# CHANNEL_DELIVERY_RETENTION_DAYS=30       # integer >= 7; the hourly sweep deletes channel_deliveries older than this
# IDENTITY_PROMPT_MAX_PER_USER=3           # link prompts per unlinked chat user per window
# IDENTITY_PROMPT_MAX_PER_CONNECTION=60    # ... and per workspace/guild
# IDENTITY_PROMPT_WINDOW_SECONDS=900
