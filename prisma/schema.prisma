enum DependencyType {
  BLOCKS
  RELATES_TO
  // REQUIRES removed — was functionally identical to BLOCKS
  @@map("dependency_type")
}

enum CommentableType {
  TASK
  PROJECT
  ACTIVITY
  @@map("commentable_type")
}

enum ReactableType {
  COMMENT
  ACTIVITY
  @@map("reactable_type")
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  CELEBRATE
  THINKING
  @@map("reaction_type")
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  USER
  URL
  @@map("field_type")
}

enum ActivityAction {
  PARENT_CHANGED // step 1.3; metadata {from, to}
  TASK_MOVED // step 1.3; project change of a task/subtree; metadata {from, to, descendants}
  ISSUE_TYPE_CHANGED // step 1.5; metadata {from, to}
  ITERATION_CHANGED // step 1.5; metadata {from, to}
  WORKFLOW_CHANGED // step 1.4 (ADR-0006); project-level: status created/edited/deleted/reordered, transitions, settings; metadata {op, ...}
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  ASSIGNED
  UNASSIGNED
  DESCRIPTION_UPDATED
  COMMENTED
  MENTIONED
  ARCHIVED
  RESTORED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  DUE_DATE_APPROACHING // system-generated (scheduled job), actorId null,
                        // visibility SILENT — see Activity & Notifications
                        // module design note
  ATTACHMENT_ADDED     // fires on Attachment CONFIRM, never on upload-URL
                        // issuance — an abandoned/never-confirmed upload
                        // must never appear in the feed
  TAG_ADDED            // step 0.8: tag attached to a task. TIMELINE, metadata
                        // {tagId, tagName}. No notification (FanoutService no-op).
  TAG_REMOVED          // step 0.8: tag detached from a task. Same shape.
  EXTERNAL_LINKED      // step 2.6: a PR / issue / commit / branch was linked to the task by an integration. TIMELINE for PR+ISSUE, SILENT
                        // for COMMIT+BRANCH (no channel flood). metadata {provider, kind, ref, title, login?}. No in-app notification.
  IMPORTED_CHANGE      // step 4.6: one field change copied from an import source's history. Always visibility IMPORTED,
                        // original timestamp, metadata {field, from, to, externalId, actor:{externalId?,name?}, source, importJobId}
  REACTED              // comment reaction: written SILENT with targetType
                        // COMMENT by ReactionsService; FanoutService turns it
                        // into a REACTION_RECEIVED notification for the
                        // comment author. (Was referenced by code but missing
                        // from this enum — caught by tsc, fixed pre-baseline.)
  @@map("activity_action")
}

