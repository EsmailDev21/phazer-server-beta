/// Single-use state for one OAuth/install round trip. `nonce` IS the `state` query value.
/// `pkceVerifier` is vault-encrypted (null for providers without PKCE).
model OAuthState {
  id           String              @id @default(cuid())
  provider     IntegrationProvider
  /// CONNECT = admin connecting a provider tenant (2.1); IDENTITY = a user linking their own provider identity to `connectionId` (2.2).
  purpose      OAuthStatePurpose   @default(CONNECT)
  connectionId String?             @map("connection_id")
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  nonce        String              @unique(map: "uq_oauth_states_nonce")
  pkceVerifier String?             @map("pkce_verifier")
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String              @map("account_id")
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt    DateTime            @map("expires_at")
  consumedAt   DateTime?           @map("consumed_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([expiresAt], map: "idx_oauth_states_expires_at")
  @@map("oauth_states")
}

/// One provider account (guild / team / installation) connected to one Account. REVOKED rows are
/// kept (ADR-0009 d.3): credentials deleted, channel links paused, reconnect revives the row.
model IntegrationConnection {
  id                  String                      @id @default(cuid())
  accountId           String                      @map("account_id")
  account             Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider            IntegrationProvider
  externalAccountId   String                      @map("external_account_id")
  externalAccountName String                      @map("external_account_name")
  scopes              String[]
  status              IntegrationConnectionStatus @default(ACTIVE)
  lastError           String?                     @map("last_error")
  createdById         String                      @map("created_by_id")
  createdBy           User                        @relation(fields: [createdById], references: [id])
  lastUsedAt          DateTime?                   @map("last_used_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  credential   IntegrationCredential?
  identityLinks IdentityLink[]
  identityLinkTokens IdentityLinkToken[]
  channelLinks ChannelLink[]
  oauthStates  OAuthState[]
  importJobs   ImportJob[]
  externalRefs ExternalRef[]

  @@unique([accountId, provider, externalAccountId], map: "uq_integration_connections_account_provider_external")
  @@index([accountId, status], map: "idx_integration_connections_account_status")
  @@map("integration_connections")
}

/// Never selected by any API response (ADR-0009 d.5). `ciphertext` is the TokenVault self-describing
/// string (v1:kid:iv:tag:ct); `kid` is denormalised from it so key rotation can find stale rows.
model IntegrationCredential {
  id           String                @id @default(cuid())
  connectionId String                @unique(map: "uq_integration_credentials_connection_id") @map("connection_id")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kid          String
  ciphertext   String
  expiresAt    DateTime?             @map("expires_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([kid], map: "idx_integration_credentials_kid")
  @@map("integration_credentials")
}

/// Table only in 2.1; logic arrives in 2.2.
model IdentityLink {
  id             String                @id @default(cuid())
  connectionId   String                @map("connection_id")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalUserId String                @map("external_user_id")
  externalEmail  String?               @map("external_email")
  userId         String?               @map("user_id")
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  method         IdentityLinkMethod
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([connectionId, externalUserId], map: "uq_identity_links_connection_external_user")
  @@index([userId], map: "idx_identity_links_user_id")
  @@map("identity_links")
}

/// Table only in 2.1 (+ `pausedAt`, set by revoke). Logic arrives in 2.4-2.6.
model ChannelLink {
  id             String                @id @default(cuid())
  connectionId   String                @map("connection_id")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind           ChannelLinkKind
  externalId     String                @map("external_id")
  workspaceId    String                @map("workspace_id")
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String?               @map("project_id")
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  configuredById String                @map("configured_by_id")
  configuredBy   User                  @relation(fields: [configuredById], references: [id])
  pausedAt       DateTime?             @map("paused_at")
  /// step 2.6: provider-specific settings. REPO links: {repoFullName, statusRules: {prOpened?, prMerged?, prClosed?}} (ADR-0014).
  config         Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  subscriptions ChannelSubscription[]

  @@unique([connectionId, kind, externalId], map: "uq_channel_links_connection_kind_external")
  @@index([workspaceId], map: "idx_channel_links_workspace_id")
  @@index([projectId], map: "idx_channel_links_project_id")
  @@map("channel_links")
}

/// Table only in 2.1; the router arrives in 2.3.
model ChannelSubscription {
  id            String             @id @default(cuid())
  channelLinkId String             @map("channel_link_id")
  channelLink   ChannelLink        @relation(fields: [channelLinkId], references: [id], onDelete: Cascade)
  events        ActivityAction[]
  minVisibility ActivityVisibility @default(TIMELINE) @map("min_visibility")
  enabled       Boolean            @default(true)
  failureCount  Int                @default(0) @map("failure_count")
  /// Set when the router disabled it after repeated failures; cleared on re-enable.
  disabledReason String?           @map("disabled_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  deliveries ChannelDelivery[]

  @@index([channelLinkId], map: "idx_channel_subscriptions_channel_link_id")
  @@map("channel_subscriptions")
}

/// Table only in 2.1; written by the router in 2.3. One row per (subscription, activity): idempotent.
model ChannelDelivery {
  id             String                     @id @default(cuid())
  subscriptionId String                     @map("subscription_id")
  subscription   ChannelSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  activityId     String                     @map("activity_id")
  activity       Activity                   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status         ChannelDeliveryStatus
  attempts       Int                        @default(0)
  error          String?
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@unique([subscriptionId, activityId], map: "uq_channel_deliveries_subscription_activity")
  @@index([subscriptionId, createdAt], map: "idx_channel_deliveries_subscription_created")
  @@index([activityId], map: "idx_channel_deliveries_activity_id")
  @@index([createdAt], map: "idx_channel_deliveries_created_at")
  @@map("channel_deliveries")
}

// ---------------------------------------------------------------------------------------------------
// step 4.1 (diagrams 04, 05, 12). Import core. The state machine lives in src/imports/import-state-machine.ts;
// the column is the source of truth, every transition is a compare-and-set UPDATE ... WHERE status = <from>.
// ---------------------------------------------------------------------------------------------------

enum ImportJobStatus {
  DRAFT
  SOURCES_SELECTED
  MAPPING
  PREVIEW_READY
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELED
  ROLLING_BACK
  ROLLED_BACK
  @@map("import_job_status")
}

enum ImportIssueSeverity {
  INFO
  WARN
  ERROR
  @@map("import_issue_severity")
}

model ImportJob {
  id           String                @id @default(cuid())
  connectionId String                @map("connection_id")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspaceId  String                @map("workspace_id")
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById  String                @map("created_by_id")
  createdBy    User                  @relation("ImportJobCreator", fields: [createdById], references: [id])
  status       ImportJobStatus       @default(DRAFT)

  /// What to import: provider-specific ids (spaces / teams / projects / repos). Shape: ImportSelection.
  selection      Json?
  /// User overrides on top of the engine's suggestions (step 4.3 owns the shape; 4.1 stores it opaque).
  mappingConfig  Json?          @map("mapping_config")
  /// Dry-run report: counts, warnings, plan impact (ImportPreviewSummary).
  previewSummary Json?          @map("preview_summary")
  /// Everything in the source the person may map (MappingInventory), stored at preview (step 4.3). Bounded; never sent in the job view.
  inventory      Json?
  /// Live counters (ImportProgress). Read by the report and pushed over SSE by the executor.
  progress       Json?
  /// Where a resumed run continues: phase + cursor (ImportCheckpoint). Cleared when the job is finished.
  checkpoint     Json?
  /// comments / attachments / history / dates switches (ImportOptions).
  options        Json
  /// Step 4.9: what a finished job produced besides rows: for an import-as-template, `{ kind: 'TEMPLATE', templateId, ... }`.
  result         Json?

  /// Bumped on every start / resume; part of the queue jobId so a resume is never swallowed by BullMQ's dedupe.
  attempt        Int       @default(0)
  /// Set by the executor when it pauses (rate limit, reauth, quota) - shown to the user.
  pauseReason    String?   @map("pause_reason")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  issues       ImportJobIssue[]
  refs         ExternalRef[]
  pendingLinks ImportPendingLink[]
  fileItems    ImportFileItem[]

  @@index([workspaceId, createdAt], map: "idx_import_jobs_workspace_created")
  @@index([connectionId, status], map: "idx_import_jobs_connection_status")
  @@index([status], map: "idx_import_jobs_status")
  @@map("import_jobs")
}

/// Provider object <-> local row. THE idempotency key of re-running an import (unique on
/// connection + externalType + externalId) and the index rollback walks (by importJobId). `localId` is
/// deliberately not an FK: it points at tasks, projects, tags, comments... (polymorphic, `localType`).
model ExternalRef {
  id           String                @id @default(cuid())
  connectionId String                @map("connection_id")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The job that CREATED the row. A re-run that finds the ref does not move it (rollback of the re-run must not
  /// delete what the first run made).
  importJobId  String                @map("import_job_id")
  importJob    ImportJob             @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  externalType String                @map("external_type")
  externalId   String                @map("external_id")
  /// Human key, e.g. PROJ-42. Display only.
  externalKey  String?               @map("external_key")
  localType    String                @map("local_type")
  localId      String                @map("local_id")
  /// Hash of the normalised source content: unchanged on re-run = skip; changed = update (4.4).
  contentHash  String?               @map("content_hash")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([connectionId, externalType, externalId], map: "uq_external_refs_connection_type_external")
  @@index([importJobId, localType], map: "idx_external_refs_job_local_type")
  @@index([localType, localId], map: "idx_external_refs_local")
  @@map("external_refs")
}

model ImportJobIssue {
  id          String              @id @default(cuid())
  importJobId String              @map("import_job_id")
  importJob   ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  severity    ImportIssueSeverity
  /// Stable machine code, e.g. USER_UNMAPPED, DESCRIPTION_TRUNCATED, DEPENDENCY_CYCLE.
  code        String
  /// The provider-side object it is about: "<externalType>:<externalId>" or a key. Null = job-level.
  externalRef String?             @map("external_ref")
  message     String
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([importJobId, severity, createdAt], map: "idx_import_job_issues_job_severity")
  @@map("import_job_issues")
}


/// Step 4.4. A parent or dependency whose other end was not imported yet when the task page was written (pages arrive in the
/// provider's order, not parents-first). Written in the SAME transaction as the page, resolved by the LINKS phase at the end,
/// deleted when the job finishes. A table (not the checkpoint) so a million-task import cannot bloat the job row.
/// Step 4.6 (diagram 05, lane "Attachment copy"). One file an import still has to copy from the provider (or has copied).
/// Written in the SAME transaction as its task, drained by the attachment-copy phase on the `import-files` queue.
model ImportFileItem {
  id            String    @id @default(cuid())
  importJobId   String    @map("import_job_id")
  importJob     ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  /// The provider's id of the attachment (the ExternalRef key once copied).
  externalId    String    @map("external_id")
  /// The local task the file belongs to.
  taskId        String    @map("task_id")
  fileName      String    @map("file_name")
  mimeType      String?   @map("mime_type")
  /// Declared size when the source states one; the real size is measured while copying.
  sizeBytes     Int?      @map("size_bytes")
  /// Opaque to everything but the adapter's fetchAttachment.
  providerRef   String    @map("provider_ref")
  /// Local user the file is credited to (the importer when the source person has no account).
  uploadedById  String    @map("uploaded_by_id")
  /// Source timestamp, kept when the job keeps dates.
  sourceCreatedAt DateTime? @map("source_created_at")
  /// 'PENDING' | 'DONE' | 'SKIPPED' | 'FAILED'
  status        String    @default("PENDING")
  /// Failed download attempts so far (a file that keeps failing is given up on, the import carries on).
  attempts      Int       @default(0)
  /// The quota-reserving PENDING attachment row, created before the first byte is fetched and reused by a retry.
  attachmentId  String?   @map("attachment_id")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([importJobId, taskId, externalId], map: "uq_import_file_items")
  @@index([importJobId, status, id], map: "idx_import_file_items_job_status")
  @@map("import_file_items")
}

model ImportPendingLink {
  id             String    @id @default(cuid())
  importJobId    String    @map("import_job_id")
  importJob      ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  /// 'PARENT' | 'DEPENDENCY'
  kind           String
  /// PARENT: the child. DEPENDENCY: the blocking task.
  fromExternalId String    @map("from_external_id")
  /// PARENT: the parent. DEPENDENCY: the blocked task.
  toExternalId   String    @map("to_external_id")
  /// DependencyType for a DEPENDENCY ('' for a PARENT: part of the unique key, so it is not nullable).
  depType        String    @default("") @map("dep_type")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([importJobId, kind, fromExternalId, toExternalId, depType], map: "uq_import_pending_links")
  @@index([importJobId, id], map: "idx_import_pending_links_job")
  @@map("import_pending_links")
}

/// Step 2.2 (ADR-0010 d.2): one-time "link your account" token. Only the SHA-256 of the token is stored;
/// the token itself exists only in the ephemeral chat reply. At most one live token per (connection, external user).
model IdentityLinkToken {
  id             String                @id @default(cuid())
  tokenHash      String                @unique(map: "uq_identity_link_tokens_token_hash") @map("token_hash")
  connectionId   String                @map("connection_id")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalUserId String                @map("external_user_id")
  expiresAt      DateTime              @map("expires_at")
  consumedAt     DateTime?             @map("consumed_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([connectionId, externalUserId], map: "idx_identity_link_tokens_connection_external")
  @@index([expiresAt], map: "idx_identity_link_tokens_expires_at")
  @@map("identity_link_tokens")
}

/// Step 2.4 (ADR-0012 d.7): one row per deferred chat command, keyed by the provider's interaction id. Makes the WRITE
/// at-most-once while the job (and its reply to the provider) stays at-least-once: a retried job reuses the stored result.
model ChatCommandRun {
  id            String              @id @default(cuid())
  provider      IntegrationProvider
  interactionId String              @map("interaction_id")
  /// RUNNING until the executor returned; DONE once `result` is stored.
  status        String
  result        Json?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([provider, interactionId], map: "uq_chat_command_runs_provider_interaction")
  @@index([createdAt], map: "idx_chat_command_runs_created_at")
  @@map("chat_command_runs")
}

// ===========================================================================
// Step 3.5 - Templates (diagram 13). A Template is the mutable envelope; a
// TemplateVersion is an IMMUTABLE blueprint snapshot (database trigger, see
// migration 20260620000000). Visibility is PRIVATE | ACCOUNT | PUBLIC (seeds only);
// UNLISTED arrives with the marketplace (Phase 6); PUBLIC (step 3.9) is for first-party seeds.
// ===========================================================================
enum TemplateKind {
  WORKSPACE
  PROJECT

  @@map("template_kind")
}

enum TemplateVisibility {
  PRIVATE // creator (and account OWNER/ADMIN) only
  ACCOUNT // every MEMBER+ of the owning account
  /// Step 3.9. Readable, appliable and forkable by EVERY signed-in user; editable by nobody outside the
  /// owning account. Only the system account may own one (checked in TemplatesService; Phase 6's
  /// marketplace widens that to approved listings).
  PUBLIC

  @@map("template_visibility")
}

model Template {
  id             String             @id @default(cuid())
  ownerAccountId String             @map("owner_account_id")
  ownerAccount   Account            @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  createdById    String             @map("created_by_id")
  createdBy      User               @relation("TemplateCreator", fields: [createdById], references: [id])
  kind           TemplateKind
  visibility     TemplateVisibility @default(PRIVATE)
  name           String
  description    String?
  category       String?
  tags           String[]           @default([])

  /// Step 3.9. Stable identity of a first-party template (e.g. "student-workspace"); NULL for every
  /// user-made one. Only the seeder sets it, and a fork never inherits it.
  seedKey String? @unique(map: "uq_templates_seed_key") @map("seed_key")

  // Fork lineage. Both are SET NULL when the source is deleted: a fork is
  // self-contained (it owns a copy of the blueprint), only the pointer goes.
  sourceTemplateId String?          @map("source_template_id")
  sourceTemplate   Template?        @relation("TemplateFork", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  forks            Template[]       @relation("TemplateFork")
  sourceVersionId  String?          @map("source_version_id")
  sourceVersion    TemplateVersion? @relation("ForkedFromVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions TemplateVersion[] @relation("TemplateVersions")
  assets   TemplateAsset[]
  draft    TemplateDraft?

  /// Step 3.8. Last editor key number handed out for this template ("n<seq>" nodeKeys, "a<seq>" asset
  /// keys). Only ever moves forward, so a key is never reused for something else.
  nodeKeySeq Int @default(0) @map("node_key_seq")

  @@index([ownerAccountId, createdAt], map: "idx_templates_owner_account_created")
  @@index([sourceTemplateId], map: "idx_templates_source_template")
  @@index([createdById], map: "idx_templates_created_by")
  @@map("templates")
}

model TemplateVersion {
  id            String   @id @default(cuid())
  templateId    String   @map("template_id")
  template      Template @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  /// 1, 2, 3... in creation order; the "latest" version is the highest.
  sequence      Int
  semver        String
  schemaVersion Int      @map("schema_version")
  /// A validated BlueprintV1. Never edited: a change is a new version.
  blueprint     Json
  /// "sha256:<hex>" of the canonical JSON of `blueprint`.
  checksum      String
  /// computeBlueprintStats() at the time of writing (counts, for listings and plan preflight).
  stats         Json
  sizeBytes     Int      @map("size_bytes")
  changelog     String?
  createdById   String   @map("created_by_id")
  createdBy     User     @relation("TemplateVersionCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  forkedInto Template[] @relation("ForkedFromVersion")
  installs   TemplateInstall[]

  @@unique([templateId, sequence], map: "uq_template_versions_template_sequence")
  @@unique([templateId, semver], map: "uq_template_versions_template_semver")
  @@map("template_versions")
}


// ===========================================================================
// Step 3.6 - applying a template. One TemplateInstall per apply; one item per
// entity the apply CREATED or REUSED (what powers undo and, later, upgrades).
// ===========================================================================
enum TemplateInstallMode {
  NEW_WORKSPACE // target workspace was empty and the caller said so
  MERGE

  @@map("template_install_mode")
}

enum TemplateInstallStatus {
  APPLYING
  APPLIED
  FAILED
  UNDONE

  @@map("template_install_status")
}

enum TemplateInstallAction {
  CREATED
  REUSED
  SKIPPED

  @@map("template_install_action")
}

model TemplateInstall {
  id          String  @id @default(cuid())
  /// SET NULL: deleting a template (hard delete) must not delete the history of what it created.
  versionId   String? @map("version_id")
  version     TemplateVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  /// Snapshots, because the version row may be gone.
  templateName    String @map("template_name")
  versionSemver   String @map("version_semver")
  versionChecksum String @map("version_checksum")
  accountId   String  @map("account_id")
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaceId String  @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appliedById String  @map("applied_by_id")
  appliedBy   User    @relation("TemplateInstaller", fields: [appliedById], references: [id])
  mode        TemplateInstallMode
  variables       Json @default("{}")
  roleAssignments Json @default("{}") @map("role_assignments")
  moduleSelection Json @default("{}") @map("module_selection")
  status      TemplateInstallStatus @default(APPLYING)
  /// counts, reused vs created, warnings, timings, the failure reason.
  report      Json    @default("{}")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  undoneAt    DateTime? @map("undone_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  items TemplateInstallItem[]

  @@index([workspaceId, createdAt], map: "idx_template_installs_workspace_created")
  @@index([versionId], map: "idx_template_installs_version")
  @@index([appliedById], map: "idx_template_installs_applied_by")
  @@map("template_installs")
}

model TemplateInstallItem {
  id         String   @id @default(cuid())
  installId  String   @map("install_id")
  install    TemplateInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  /// TAG | CUSTOM_FIELD | ISSUE_TYPE | ITERATION | PROJECT | TASK | ATTACHMENT | AUTOMATION | SAVED_VIEW (CHECK in the migration)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  nodeKey    String?  @map("node_key")
  action     TemplateInstallAction
  undoneAt   DateTime? @map("undone_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([installId, entityType, entityId], map: "uq_template_install_items_entity")
  @@index([installId, entityType], map: "idx_template_install_items_install_type")
  @@index([entityType, entityId], map: "idx_template_install_items_entity")
  @@map("template_install_items")
}

/// Step 3.7. A reference file a template carries. The bytes live in object storage under
/// `storageKey`; blueprint.assets[].sha256 points here. Scoped to the TEMPLATE (shared by all its
/// versions, copied on fork), so deleting a template needs no reference counting.
model TemplateAsset {
  id          String   @id @default(cuid())
  templateId  String   @map("template_id")
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sha256      String
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @map("storage_key")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([templateId, sha256], map: "uq_template_assets_template_sha")
  @@map("template_assets")
}

/// Step 3.8. The one work-in-progress copy of a template: a VALID blueprint that the editor changes
/// with operations. Unlike a version it is mutable; publishing turns it into the next version.
/// `revision` rises on every change and every write must quote it (no silent overwrites).
model TemplateDraft {
  id           String   @id @default(cuid())
  templateId   String   @unique @map("template_id")
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// The version this draft started from. Publishing is refused when a newer version exists.
  baseSequence Int      @map("base_sequence")
  baseChecksum String   @map("base_checksum")
  blueprint    Json
  revision     Int      @default(1)
  createdById  String   @map("created_by_id")
  updatedById  String   @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("template_drafts")
}


// ===========================================================================
// Step 5.1 - Automations (diagram 11). A rule is DATA, never code: a trigger, optional conditions
// and a short list of actions, validated against the v1 DSL (src/automations/dsl). Nothing runs
// them yet (5.2). `ruleVersion` 0 = a raw definition imported from elsewhere and not yet translated
// (kept in `sourceDefinition`, never enabled); 1 = the v1 DSL. A rule that uses a construct this
// build cannot execute (e.g. a chat notification before Phase 2) is stored with those constructs
// listed in `unsupported` and cannot be enabled; the database enforces both (migration CHECKs).
// ===========================================================================
enum AutomationOrigin {
  USER
  TEMPLATE
  IMPORT
  GITHUB_RULE

  @@map("automation_origin")
}

enum AutomationRunStatus {
  OK
  SKIPPED
  FAILED

  @@map("automation_run_status")
}

model Automation {
  automationWaits AutomationWait[]
  automationMessages AutomationMessage[]
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = the whole workspace; set = only tasks of that project (and the only scope where
  /// per-project workflow statuses can be named).
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  /// normalizeName(); unique per workspace, so "Close done" and "close  DONE" are one name.
  nameKey     String   @map("name_key")
  enabled     Boolean  @default(false)
  /// 0 = raw import (see above), 1 = DSL v1.
  ruleVersion Int      @default(1) @map("rule_version")
  /// trigger.type, copied out so the runner can index on it; 'RAW' when ruleVersion is 0.
  triggerType String   @map("trigger_type")
  trigger     Json
  conditions  Json     @default("{}")
  actions     Json     @default("[]")
  /// [{path, construct, reason}] the v1 validator accepted but this build cannot execute.
  unsupported Json     @default("[]")
  /// Step 5.2. Why the runner switched this rule off (loop or rate breaker). Only set while it is off; cleared when someone turns it on.
  pausedReason String? @map("paused_reason")
  /// The foreign rule exactly as received (imports / GitHub status rules), until it is translated.
  sourceDefinition Json? @map("source_definition")
  createdVia  AutomationOrigin @default(USER) @map("created_via")
  createdById String   @map("created_by_id")
  createdBy   User     @relation("AutomationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  runs AutomationRun[]

  @@unique([workspaceId, nameKey], map: "uq_automations_workspace_name_key")
  @@index([workspaceId, triggerType, enabled], map: "idx_automations_runner")
  @@index([projectId])
  @@map("automations")
}

/// One execution (or one decision not to execute) of a rule for one event. `(automationId, eventId)`
/// is unique: the same event delivered twice runs a rule once (5.2 relies on it). History, so a
/// deleted task only loses the pointer.
model AutomationRun {
  automationWaits AutomationWait[]
  id           String              @id @default(cuid())
  automationId String              @map("automation_id")
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  workspaceId  String              @map("workspace_id")
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId       String?             @map("task_id")
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// The domain event that caused it (activity id, or a scheduler tick id for DUE_APPROACHING).
  eventId      String              @map("event_id")
  status       AutomationRunStatus
  /// Why it did not run (SKIPPED) or what failed (FAILED). Short; never a stack trace.
  error        String?
  /// How many rule-triggered hops deep this run is (0 = caused by a person or an adapter).
  depth        Int                 @default(0)
  actionsRun   Int                 @default(0) @map("actions_run")
  details      Json?
  ranAt        DateTime            @default(now()) @map("ran_at")

  @@unique([automationId, eventId], map: "uq_automation_runs_event")
  @@index([automationId, ranAt])
  @@index([workspaceId, ranAt])
  @@map("automation_runs")
}


// ===========================================================================
// Step 5.4 - Saved views (diagram 11). A view is a named way of looking at tasks: a layout plus a
// config (filters, grouping, sort, columns) validated against the workspace's real fields
// (src/views/dsl). PERSONAL (is_shared = false) = visible to its owner only; SHARED = every member
// of the workspace sees it, and only an admin (`editWorkspace`) creates, changes or removes one.
// A shared view outlives its owner (owner_id SET NULL); a personal one always has an owner (CHECK).
// Names are unique per owner (personal) / per workspace (shared), within one scope (a project, or
// the whole workspace): partial unique indexes in the migration. Running a view is not part of 5.4.
// ===========================================================================
enum SavedViewLayout {
  LIST
  BOARD
  TABLE
  CALENDAR
  TIMELINE

  @@map("saved_view_layout")
}

model SavedView {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = the whole workspace; set = a view of that project (the only scope where per-project statuses can be named).
  projectId   String?         @map("project_id")
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String?         @map("owner_id")
  owner       User?           @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  /// normalizeName(); see the unique indexes in the migration (they cannot be expressed here).
  nameKey     String          @map("name_key")
  layout      SavedViewLayout
  config      Json
  isShared    Boolean         @default(false) @map("is_shared")
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([workspaceId, isShared], map: "idx_saved_views_workspace_shared")
  @@index([ownerId])
  @@index([projectId])
  @@map("saved_views")
}

/// Step 5.14. The text of one NOTIFY a rule ran (rendered), the SOURCE its notifications point at. It
/// outlives the rule and the task (SetNull), so an old notification still reads.
model AutomationMessage {
  id           String      @id @default(cuid())
  workspaceId  String      @map("workspace_id")
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String?     @map("automation_id")
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  taskId       String?     @map("task_id")
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  message      String
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([workspaceId, createdAt], map: "idx_automation_messages_workspace")
  @@index([automationId], map: "idx_automation_messages_automation")
  @@index([taskId], map: "idx_automation_messages_task")
  @@map("automation_messages")
}

enum AutomationWaitStatus {
  PENDING
  RESUMING
  DONE
  FAILED
  CANCELLED
  @@map("automation_wait_status")
}

/// Step 5.15. What is left of a run that reached a WAIT: a snapshot of the rule's actions and the position
/// in them. See the migration for the lifecycle.
model AutomationWait {
  id           String               @id @default(cuid())
  workspaceId  String               @map("workspace_id")
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String               @map("automation_id")
  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId        String?              @map("run_id")
  run          AutomationRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  taskId       String?              @map("task_id")
  task         Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  resumeAt     DateTime             @map("resume_at")
  status       AutomationWaitStatus @default(PENDING)
  actions      Json
  frames       Json
  error        String?
  createdAt    DateTime             @default(now()) @map("created_at")
  resumedAt    DateTime?            @map("resumed_at")

  @@index([status, resumeAt], map: "idx_automation_waits_due")
  @@index([workspaceId, status], map: "idx_automation_waits_workspace")
  @@index([automationId, status], map: "idx_automation_waits_automation")
  @@index([taskId], map: "idx_automation_waits_task")
  @@map("automation_waits")
}

