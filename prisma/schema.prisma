enum CreationMode {
  SNAP
  FOCUS
  MANUAL
  // step 0.6: added ahead of their consumers (Phase 1 imports, Phase 3
  // templates, Phase 2 integrations respectively). Nothing sets these
  // three yet; TasksService.create still only ever writes SNAP/FOCUS/MANUAL.
  IMPORT
  TEMPLATE
  INTEGRATION
  /// step 5.2: a write made by an automation rule (WriteContext.automation says which, and how deep)
  AUTOMATION
  @@map("creation_mode")
