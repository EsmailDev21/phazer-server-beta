  COMMENTER
  CONTRIBUTOR
  @@map("collaborator_role")
}

enum TeamIcon {
  USERS
  MEGAPHONE
  CODE
  BRUSH
  ROCKET
  // ...remaining icon set carried forward unchanged from the original schema
  @@map("team_icon")
}

enum InviteTargetType {
  ACCOUNT
  WORKSPACE
  TEAM
  PROJECT
  @@map("invite_target_type")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  // INBOX removed — absence of projectId represents Inbox now
  @@map("task_status")
