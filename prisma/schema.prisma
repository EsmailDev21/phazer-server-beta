// ============================================================
// OPTIMIZED SCHEMA — full rebuild
// Every model below was decided conversationally against the audit
// findings from the original app (see: schema_graph_v2.d2,
// api_contract_graph_v2.d2, business_logic_findings_v1.md,
// optimized_schema_graph_v1.d2). Comments reference the specific
// decision so context isn't lost.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // NEVER hardcode — see audit finding on leaked prod credentials
}

// ============================================================
// IDENTITY & TENANCY
// ============================================================

model User {
  automationsCreated Automation[] @relation("AutomationCreator")
  savedViews         SavedView[]  @relation("SavedViewOwner")
  importJobs ImportJob[] @relation("ImportJobCreator")
  id       String  @id @default(cuid())
  oauthStates                   OAuthState[]
  integrationConnectionsCreated IntegrationConnection[]
  identityLinks                 IdentityLink[]
  channelLinksConfigured        ChannelLink[]
  email    String  @unique
  username String  @unique
  name     String
  avatar   String?
  googleId String? @unique @map("google_id")
  password String?

  emailVerified Boolean   @default(false) @map("email_verified")
  onboardedAt DateTime? @map("onboarded_at")

  // step 0.6: outside account RBAC (see PlatformRole's doc) - default NONE
  // so every existing row is unaffected; only Phase 6's moderation queue
  // will ever set this to MODERATOR/ADMIN.
  platformRole PlatformRole @default(NONE) @map("platform_role")

  bio      String?
  location String?
  website  String?
  github   String?
  twitter  String?
  linkedin String?

  // NOTE: zero billing fields here on purpose. Billing lives on Account,
  // for both personal and org — one shape, one source of truth, resolved
  // after the personal-billing-never-actually-implemented finding.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preferences      UserPreferences?
  refreshTokens    RefreshToken[]
  ownedAccount     Account?              @relation("PersonalAccountOwner")
  accountMembers   AccountMember[]
  teamMembers      TeamMember[]
  workspaceCollabs WorkspaceCollaborator[] @relation("CollaboratorUser")
  workspaceGuests  WorkspaceGuest[]      @relation("GuestUser")
  projectMembers   ProjectMember[]
  assignedTasks    Task[]                @relation("TaskAssignees")
  createdTasks     Task[]                @relation("TaskCreator")
  createdProjects  Project[]             @relation("ProjectCreator")
  comments         Comment[]
  reactions        Reaction[]
  mentions         Mention[]             @relation("MentionedUser")
  watches          Watch[]
  activities       Activity[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  snapSessions     SnapSession[]
  shareLinks       ShareLink[]
  uploadedAttachments Attachment[]
  createdTemplates Template[] @relation("TemplateCreator") // step 3.5
  createdTemplateVersions TemplateVersion[] @relation("TemplateVersionCreator") // step 3.5
  templateInstalls TemplateInstall[] @relation("TemplateInstaller") // step 3.6

  @@map("users")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredMode CreationMode @default(SNAP) @map("preferred_mode")
  // Validated shape (NOT an arbitrary blob, per the DTO-discipline established
  // throughout this rebuild): map of NotificationType -> {inApp, email, push}
  notificationSettings Json? @map("notification_settings")
  uiPreferences Json? @map("ui_preferences")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId String @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String? @map("device_info")
  lastUsedAt DateTime? @map("last_used_at")
  revoked    Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// The ownership + billing root. ONE shape for personal and organizational
// accounts — resolves the old schema's duplicated User/Workspace billing
// fields and the "personal billing API was never actually built" finding.
model Account {
  id   String      @id @default(cuid())
  type AccountType
  integrationConnections IntegrationConnection[]
  oauthStates            OAuthState[]

  // Billing — identical shape regardless of type
  planType PlanKey? @map("plan_type") // no DB default — set explicitly at
                                   // Account creation time (FREE_PERSONAL
                                   // for PERSONAL accounts, FREE_ORG for
                                   // ORGANIZATION), since the two types
                                   // have different free-tier defaults and
                                   // one shared @default() can't express that
  paymentProvider PaymentProvider? @map("payment_provider") // which provider this account is
                                   // currently set up with — determined at
                                   // first checkout from billing country,
                                   // stable afterward unless explicitly migrated
  externalCustomerId String?   @unique @map("external_customer_id") // generalized from stripeCustomerId —
                                   // meaning depends on paymentProvider
  externalSubscriptionId String? @map("external_subscription_id")
  subscriptionStatus String? @map("subscription_status")
  billingCountry String? @map("billing_country") // ISO 3166-1 alpha-2, e.g. "TN", "US".
                                   // Found missing during the consolidated
                                   // cross-module check — Billing module's
                                   // provider routing (determineProvider)
                                   // referenced this field without it ever
                                   // being added. Set explicitly at Account
                                   // creation (required before first
                                   // checkout), never inferred from
                                   // request IP — consistent with the
                                   // Foundations "never inferred, never
                                   // defaulted" rule.
  seatsIncluded Int       @default(1) @map("seats_included")
  seatsUsed Int       @default(1) @map("seats_used")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd DateTime? @map("current_period_end")
  canceledAt DateTime? @map("canceled_at")
  trialEndsAt DateTime? @map("trial_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // ADDED — Tenancy module, DELETE /accounts/:id spec: soft-delete with a
  // 30-day grace period before a scheduled purge job hard-deletes. Not in
  // the original ground-truth schema; added additively here rather than
  // guessed around, per explicit decision. NULL = active account.
  deletedAt DateTime? @map("deleted_at")

  // Exactly one of these is set, enforced at the app layer based on `type`
  personalOwnerId String? @unique @map("personal_owner_id")
  personalOwner   User?   @relation("PersonalAccountOwner", fields: [personalOwnerId], references: [id])
  organization    Organization?

  workspaces Workspace[]
  teams      Team[]
  members    AccountMember[]
  payments   Payment[]
  invoices   Invoice[]
  usageMetrics UsageMetric[]
  auditLogs  AuditLog[]

  @@index([type])
  @@index([deletedAt])
  workspaceKeyAliases WorkspaceKeyAlias[] // step 1.1
  templates Template[] // step 3.5
  templateInstalls TemplateInstall[] // step 3.6

  /// Step 3.9. TRUE for the single account that owns the first-party templates (a partial unique
  /// index in the migration keeps it to one). Not a billing or membership concept: nobody signs in
  /// to it, and it is exempt from the template plan limit.
  isSystem Boolean @default(false) @map("is_system")

  @@map("accounts")
}

model Organization {
  id        String   @id @default(cuid())
  accountId String   @unique @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model Workspace {
  channelLinks ChannelLink[]
  automationWaits AutomationWait[]
  automationMessages AutomationMessage[]
  id          String  @id @default(cuid())
  accountId String @map("account_id") // ONE FK — personal-vs-org encoded by Account.type, not a 3-way XOR
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String?

  // step 1.1 (ADR-0004). A task's key is "<key>-<number>", e.g. ENG-123.
  // `key` is unique PER ACCOUNT. Stored uppercase, ^[A-Z][A-Z0-9]{1,9}$ (CHECK in the migration). Changed
  // only through WorkspaceKeysService, which keeps the old key reserved and
  // resolvable via WorkspaceKeyAlias - never write it directly.
  key String @map("key")
  // The NEXT number to hand out. Advanced with one atomic UPDATE inside the
  // task-create transaction, so a rollback rolls it back (gapless) and
  // concurrent creates serialize on this row.
  nextTaskNumber Int @default(1) @map("next_task_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keyAliases    WorkspaceKeyAlias[]
  teamAccess    WorkspaceTeamAccess[]
  collaborators WorkspaceCollaborator[] // PERSONAL accounts only, app-enforced
  guests        WorkspaceGuest[]        // ORGANIZATION accounts only, app-enforced
  projects      Project[]
  tasks         Task[]
  customFields  CustomField[]
  tags          Tag[]
  issueTypes    IssueType[]
  iterations    Iteration[]
  automations   Automation[]
  automationRuns AutomationRun[]
  savedViews    SavedView[]
  importJobs   ImportJob[]

  @@unique([accountId, key], map: "uq_workspaces_account_id_key")
  @@index([accountId])
  templateInstalls TemplateInstall[] // step 3.6

  @@map("workspaces")
}

/// step 1.1 (ADR-0004). A RETIRED workspace key. Keeps `ENG-12` in an old PR
/// title resolving to the right task after the workspace renames to PLAT, and
/// keeps ENG reserved in the account so nobody else can take it. Together with
/// every workspace's current key, no key is ever ambiguous within an account.
/// Deleting the workspace deletes its aliases (the key becomes free again).
model WorkspaceKeyAlias {
  id          String    @id @default(cuid())
  accountId   String    @map("account_id")
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key         String
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([accountId, key], map: "uq_workspace_key_aliases_account_id_key")
  @@index([workspaceId], map: "idx_workspace_key_aliases_workspace_id")
  @@map("workspace_key_aliases")
}

model Team {
  id        String   @id @default(cuid())
  accountId String @map("account_id") // must be an ORGANIZATION-type Account — app-enforced
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  type      String?
  icon      TeamIcon @default(USERS)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      TeamMember[]
  workspaceAccess WorkspaceTeamAccess[]

  @@index([accountId])
  @@map("teams")
}

model AccountMember {
  id        String   @id @default(cuid())
  accountId String @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(MEMBER)
  permissions Json?  // fine-grained overrides on top of role, e.g. "VIEWER who can comment"
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO role field — role always comes from AccountMember. You're an
  // AccountMember before you can be a TeamMember (app-enforced).
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@map("team_members")
}

// CONFIRMED: carries its OWN role, applied to every team member for this
// workspace, independent of their individual AccountMember role
// (GitHub-Teams-style). Overlapping grants from multiple teams on the same
// workspace: most-permissive wins among the ties.
model WorkspaceTeamAccess {
  id          String    @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamId String @map("team_id")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role        Role      @default(MEMBER)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, teamId])
  @@map("workspace_team_access")
}

// PERSONAL workspaces only. Kept genuinely distinct from AccountMember
// (org seats) per explicit product decision — different role vocabulary,
// different billing meaning (free-vs-paid collaborator slots).
model WorkspaceCollaborator {
  id              String            @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedUserId String @map("invited_user_id")
  invitedUser     User              @relation("CollaboratorUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  role            CollaboratorRole  @default(VIEWER)
  isFreeSlot Boolean           @default(true) @map("is_free_slot") // billing-metered per BILLING_SETUP.md
  invitedAt DateTime          @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  @@unique([workspaceId, invitedUserId])
  @@map("workspace_collaborators")
}

// ORGANIZATION workspaces only. Added after the optimized-schema graphing
// pass surfaced a real gap: org workspaces had no non-billable,
// workspace-wide access tier (only per-project ProjectMember rows, or a
// full paying AccountMember seat). Named distinctly from
// WorkspaceCollaborator per the enum-naming-collision lesson from the
// same pass — not reused, despite the conceptual similarity.
model WorkspaceGuest {
  id            String    @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedUserId String @map("invited_user_id")
  invitedUser   User      @relation("GuestUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  role          CollaboratorRole @default(VIEWER)
  invitedAt DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  @@unique([workspaceId, invitedUserId])
  @@map("workspace_guests")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(MEMBER) // includes CLIENT — only source of access
                                        // for users with no AccountMember row at all
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

// ONE invite system, not two. role validated against the correct enum
// for targetType at the DTO layer (was force-cast with `as any` before).
// targetId is polymorphic (Account | Workspace | Team) — Prisma cannot
// express a single FK column pointing at multiple tables, so this is
// intentionally NOT a Prisma relation. Resolved at the application layer
// (InviteService branches on targetType, then queries the matching table).
model Invite {
  id         String       @id @default(cuid())
  tokenHash String       @unique @map("token_hash")
  email      String?      // nullable = shareable/public invite link
  targetType InviteTargetType @map("target_type")
  targetId String @map("target_id") // no @relation — see note above
  role       Role         // authoritative for ACCOUNT/TEAM/PROJECT targets.
                            // For WORKSPACE targets this is a REQUIRED-BUT-
                            // UNUSED placeholder (defaulted to VIEWER by the
                            // service) — see collaboratorRole below.
  // ADDED — Tenancy module. Role (OWNER/ADMIN/MEMBER/VIEWER/CLIENT) and
  // CollaboratorRole (VIEWER/COMMENTER/CONTRIBUTOR) are genuinely different
  // enums (schema-confirmed, only VIEWER overlaps by name). Accepting a
  // WORKSPACE-target invite creates a WorkspaceCollaborator (personal) or
  // WorkspaceGuest (org), both typed CollaboratorRole — `role` above can't
  // express COMMENTER/CONTRIBUTOR. This field is the authoritative role
  // for WORKSPACE-target invites; REQUIRED when targetType===WORKSPACE,
  // NULL otherwise (app-layer validated, per explicit decision to alter
  // the schema additively rather than lose COMMENTER/CONTRIBUTOR via invite).
  collaboratorRole CollaboratorRole? @map("collaborator_role")
  inviterId String @map("inviter_id")
  expiresAt DateTime? @map("expires_at")
  maxUses Int? @map("max_uses")
  usesCount Int          @default(0) @map("uses_count")
  isPublic Boolean      @default(false) @map("is_public")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("invites")
}

model Payment {
  id                    String   @id @default(cuid())
  accountId String @map("account_id") // ONE required FK, not 3-way optional
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider              PaymentProvider // which processor handled THIS
                                   // transaction — may differ from
                                   // Account.paymentProvider over time
                                   // (e.g. migrated to Stripe later)
  externalTransactionId String @map("external_transaction_id") // generalized from stripePaymentIntentId
  amount                Float
  currency              String   @default("usd")
  status                String
  receiptUrl String? @map("receipt_url")
  failureReason String? @map("failure_reason")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, externalTransactionId])
  @@index([accountId])
  @@map("payments")
}

model Invoice {
  id              String    @id @default(cuid())
  accountId String @map("account_id")
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  invoiceNumber String    @unique @map("invoice_number")
  externalInvoiceId String @map("external_invoice_id") // generalized from stripeInvoiceId. For MOR
                              // transactions this is more of a receipt
                              // reference than a tax document WE generate —
                              // Paddle/Lemon Squeezy are the legal seller
                              // and remit tax themselves; for STRIPE and
                              // TUNISIA_GATEWAY, this business IS the
                              // merchant of record and owns tax handling
  amount          Float
  currency        String    // no default — varies genuinely by provider
                              // (TND for TUNISIA_GATEWAY, USD/EUR otherwise)
  status          String
  dueDate DateTime @map("due_date")
  paidAt DateTime? @map("paid_at")
  lineItems Json @map("line_items")
  pdfUrl String? @map("pdf_url")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([provider, externalInvoiceId])
  @@index([accountId])
  @@map("invoices")
}

model UsageMetric {
  id        String   @id @default(cuid())
  accountId String @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metric    String
  value     Int
  period    String // YYYY-MM
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, metric, period])
  @@map("usage_metrics")
}

// File attachments — task/project/comment scoped, private and access-gated
// (unlike User.avatar/Organization.logo/Team.icon/Workspace.icon, which
// stay simple public-URL strings, confirmed exempt from the storage cap
// as small platform assets, not modeled here). Two-phase upload: PENDING
// on presigned-URL issuance, CONFIRMED only after the client reports a
// successful direct-to-storage upload — avoids counting an abandoned
// upload as consumed storage, but PENDING rows still count toward the
// limit check (reservation, prevents a burst of concurrent requests all
// passing the check before any of them confirm).
model Attachment {
  id              String              @id @default(cuid())
  accountId String @map("account_id") // denormalized — fast storage-sum
                                         // queries without joining through
                                         // workspace every time
  targetType AttachmentableType @map("target_type")
  targetId String @map("target_id") // polymorphic, no native relation —
                                         // same pattern as Comment/Reaction/
                                         // Invite/Notification/ShareLink
  uploadedById String @map("uploaded_by_id")
  uploadedBy      User                @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  filename        String
  mimeType String @map("mime_type")
  sizeBytes Int @map("size_bytes")
  storageKey String @map("storage_key") // internal object-storage key,
                                         // NEVER exposed to clients directly
                                         // — they get presigned URLs only
  storageProvider StorageProvider     @default(S3_COMPATIBLE) @map("storage_provider")
  status          AttachmentStatus    @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")
  /// step 4.6: hex SHA-256 of the stored bytes. Set for copied (imported) files only; the dedupe key together with
  /// (account_id, size_bytes). Several rows of one account may share a storage_key (deduped copies): the object is
  /// deleted only when no row references it any more.
  sha256 String? @map("sha256")

  @@index([targetType, targetId])
  @@index([accountId, status]) // powers the live storage-limit SUM query
  @@index([accountId, sha256], map: "idx_attachments_account_sha256")
  @@map("attachments")
}

// Public, no-account resource sharing — a growth/conversion mechanism,
// not just a passive viewer feature (confirmed: intentionally teaser-level,
// designed to drive signup rather than substitute for it). VIEW only —
// no anonymous commenting, so Comment.authorId stays required, no
// anonymous-identity problem to solve.
model ShareLink {
  id              String          @id @default(cuid())
  tokenHash String          @unique @map("token_hash")
  targetType ShareableType @map("target_type") // TASK or PROJECT only — Workspace/Account
                                    // sharing is a much bigger, more
                                    // dangerous public surface, out of
                                    // scope unless a real need emerges
  targetId String @map("target_id") // polymorphic, no native relation —
                                    // same pattern as Comment/Reaction/
                                    // Invite/Notification, resolved at
                                    // the app layer
  permissionLevel SharePermission @default(VIEW) @map("permission_level")
  createdById String @map("created_by_id") // creating a link requires auth even
                                    // though USING one doesn't
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt DateTime? @map("expires_at")
  revoked         Boolean         @default(false)
  viewCount Int             @default(0) @map("view_count") // simple counter, not an
                                    // Activity row per view — views could
                                    // be much higher-volume than comments/
                                    // reactions, wrong granularity for a
                                    // full audit-trail entry

  @@index([targetType, targetId])
  @@map("share_links")
}

// Added during the Foundations module pass (webhook idempotency fix),
// keyed compound during the multi-provider Billing update — each provider
// (Stripe, MOR, Tunisia gateway) has its own event-ID namespace, so a
// single global id could theoretically collide across providers.
// StripeService/MorService/TunisiaGatewayService.handleWebhookEvent looks
// up (provider, externalEventId) here FIRST — if found, return 200
// immediately without re-running side effects. If not found, process THEN
// insert, same transaction as the side effect where possible.
model ProcessedWebhookEvent {
  id               String          @id @default(cuid())
  provider         PaymentProvider
  externalEventId String @map("external_event_id") // the provider's own event.id
  processedAt DateTime        @default(now()) @map("processed_at")

  @@unique([provider, externalEventId])
  @@map("processed_webhook_events")
}

// ============================================================
// PROJECT / TASK CORE
// ============================================================

model Project {
  channelLinks ChannelLink[]
  id          String        @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdById String @map("created_by_id")
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id])
  // progress: COMPUTED at read time from task status counts, never stored —
  // kills the "stale progress after status change" bug class entirely

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // step 1.4 (ADR-0006). The status new tasks start in (must be category TODO).
  // Nullable ONLY because a project and its statuses reference each other, so one
  // insert order has to go through null; WorkflowService keeps it non-null.
  enforceTransitions      Boolean         @default(false) @map("enforce_transitions")
  defaultWorkflowStatusId String?         @map("default_workflow_status_id")
  defaultWorkflowStatus   WorkflowStatus? @relation("ProjectInitialStatus", fields: [defaultWorkflowStatusId], references: [id], onDelete: SetNull, map: "fk_projects_default_workflow_status")
  workflowStatuses        WorkflowStatus[] @relation("ProjectWorkflowStatuses")
  workflowTransitions     WorkflowTransition[]
  iterations              Iteration[]
  automations             Automation[]
  savedViews              SavedView[]

  tasks         Task[]
  members       ProjectMember[]

  @@index([workspaceId])
  @@map("projects")
}

model Task {
  automationWaits AutomationWait[]
  automationMessages AutomationMessage[]
  id          String       @id @default(cuid())
  workspaceId String @map("workspace_id") // required — Inbox pattern lives on projectId, not this
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId String? @map("project_id") // optional — CONFIRMED: absence of project = Inbox,
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // step 1.3 (ADR-0005). Subtasks: a tree of at most 3 levels, all in ONE project
  // (so visibility and the task cap need no extra rules). NO ACTION: the
  // database itself refuses to delete a task that still has children.
  parentId String? @map("parent_id")
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: NoAction, map: "fk_tasks_parent_id")
  children Task[]  @relation("TaskSubtasks")
                            // no separate INBOX status needed

  // step 1.1: permanent per-workspace number (see Workspace.key). Assigned from
  // Workspace.nextTaskNumber inside the create transaction. Never reused, never changed.
  number Int @map("number")

  title       String
  description String?
  status      TaskStatus   @default(TODO) // INBOX dropped — was conflating
                                            // "no project" with "workflow state"
  // step 1.4 (ADR-0006). The specific status; `status` above is its CATEGORY and stays
  // authoritative for every reader. Invariant (kept by WorkflowService, not an FK - a
  // composite FK would null the NOT NULL `status` on project delete): when set,
  // status == workflowStatus.category; every task with a project has one. SetNull so
  // deleting a project (tasks fall back to the Inbox) is never blocked by it.
  workflowStatusId String?        @map("workflow_status_id")
  workflowStatus   WorkflowStatus? @relation("TaskWorkflowStatus", fields: [workflowStatusId], references: [id], onDelete: SetNull, map: "fk_tasks_workflow_status")
  // step 1.5 (ADR-0007). Both optional; null = untyped / in no iteration (the backlog).
  // SetNull: deleting a type or an iteration never deletes or blocks tasks.
  issueTypeId String?     @map("issue_type_id")
  issueType   IssueType?  @relation(fields: [issueTypeId], references: [id], onDelete: SetNull, map: "fk_tasks_issue_type")
  iterationId String?     @map("iteration_id")
  iteration   Iteration?  @relation(fields: [iterationId], references: [id], onDelete: SetNull, map: "fk_tasks_iteration")
  // step 1.5 follow-up (ADR-0008). Story points; null = not estimated (counts as 0 points,
  // reported separately). 0..1000, CHECK in the migration. Summed over LEAF tasks only.
  estimate Float?

  // step 1.6: PRs / branches / commits / messages attached to this task (read-only here;
  // Phase 2 adapters write them).
  externalLinks ExternalLink[]
  automationRuns AutomationRun[]
  priority    Priority?
  createdById String @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignees   User[]       @relation("TaskAssignees") // CONFIRMED: multi-assignee,
                                                          // no single-owner concept
  startDate DateTime? @map("start_date") // added for Gantt view (confirmed need — proper
                          // duration bars, not just due-date markers).
                          // App-layer rule: startDate must be <= dueDate
                          // when both are set, not DB-expressible cleanly
  dueDate DateTime? @map("due_date")
  createdVia CreationMode @default(SNAP) @map("created_via")

  isArchived Boolean      @default(false) @map("is_archived") // CONFIRMED: independent of status
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dependenciesBlocking TaskDependency[] @relation("BlockingTask")
  dependenciesBlocked  TaskDependency[] @relation("BlockedTask")
  customValues  TaskCustomValue[] @relation("TaskCustomValues")
  tags          TaskTag[]
  snapClauses   SnapClause[]

  // Step 1.7: list/count/progress. The two (scope, isArchived, createdAt DESC) indexes serve
  // `ORDER BY createdAt DESC LIMIT n`; they replace the old single-column workspaceId/projectId
  // indexes (leftmost prefix).
  @@index([workspaceId, isArchived, createdAt(sort: Desc)], map: "idx_tasks_workspace_archived_created")
  @@index([projectId, isArchived, createdAt(sort: Desc)], map: "idx_tasks_project_archived_created")
  @@index([projectId, isArchived, status], map: "idx_tasks_project_archived_status")
  @@index([workspaceId, status]) // supports computed-progress queries
  @@unique([workspaceId, number], map: "uq_tasks_workspace_id_number")
  @@index([parentId], map: "idx_tasks_parent_id")
  @@index([workflowStatusId], map: "idx_tasks_workflow_status_id")
  @@index([issueTypeId], map: "idx_tasks_issue_type_id")
  @@index([iterationId], map: "idx_tasks_iteration_id")
  @@map("tasks")
}

// step 1.4 (ADR-0006). A per-project status that rolls up to one of the four categories.
// At most one isDefault per (project, category): partial unique index in the migration
// (Prisma cannot declare it); WorkflowService enforces it under the project lock.
model WorkflowStatus {
  id                  String     @id @default(cuid())
  projectId           String     @map("project_id")
  project             Project    @relation("ProjectWorkflowStatuses", fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  nameKey             String     @map("name_key") // lower-cased, NFKC, whitespace-collapsed; unique per project
  color               String     @default("#94A3B8")
  position            Int
  category            TaskStatus
  excludeFromProgress Boolean    @default(false) @map("exclude_from_progress")
  isDefault           Boolean    @default(false) @map("is_default")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tasks             Task[]               @relation("TaskWorkflowStatus")
  initialFor        Project[]            @relation("ProjectInitialStatus")
  transitionsFrom   WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo     WorkflowTransition[] @relation("TransitionTo")

  @@unique([projectId, nameKey], map: "uq_workflow_statuses_project_name_key")
  @@index([projectId, position])
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id           String         @id @default(cuid())
  projectId    String         @map("project_id")
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatusId String         @map("from_status_id")
  fromStatus   WorkflowStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId   String         @map("to_status_id")
  toStatus     WorkflowStatus @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId], map: "uq_workflow_transitions_pair")
  @@index([projectId])
  @@map("workflow_transitions")
}

enum IssueTypeLevel {
  EPIC
  STANDARD
  SUBTASK
  @@map("issue_type_level")
}

enum IterationKind {
  SPRINT
  CYCLE
  MILESTONE
  @@map("iteration_kind")
}

enum IterationState {
  PLANNED
  ACTIVE
  CLOSED
  @@map("iteration_state")
}

// step 1.5 (ADR-0007). Workspace-level. `level` is a label for pickers and importers;
// it is NOT enforced against subtask nesting (ADR-0005 owns the hierarchy rules).
model IssueType {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  nameKey     String         @map("name_key") // same normalisation as tags; unique per workspace
  icon        String?
  color       String         @default("#94A3B8")
  level       IssueTypeLevel @default(STANDARD)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tasks Task[]

  @@unique([workspaceId, nameKey], map: "uq_issue_types_workspace_name_key")
  @@map("issue_types")
}

// step 1.5 (ADR-0007). Whole-workspace (projectId null) or one project's. Scope is fixed at
// creation. Dates are calendar dates. Closed iterations take no new tasks; they can be reopened.
model Iteration {
  id           String         @id @default(cuid())
  workspaceId  String         @map("workspace_id")
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String?        @map("project_id")
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         IterationKind
  name         String
  goal         String?
  startDate    DateTime?      @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  state        IterationState @default(PLANNED)
  closedAt     DateTime?      @map("closed_at")
  // What closing did: {unfinished, action: LEAVE|MOVE|BACKLOG, movedToId, completed}.
  closeSummary Json?          @map("close_summary")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tasks Task[]

  @@index([workspaceId, state])
  @@index([projectId])
  @@map("iterations")
}

enum ExternalLinkKind {
  PR
  ISSUE
  COMMIT
  BRANCH
  MESSAGE
  THREAD
  @@map("external_link_kind")
}

/// step 1.6 (diagram 11). A pointer from a task to something in another system. Written only
/// by Phase 2 adapters (through DomainWriter); step 1.6 adds the model and the read.
/// `(taskId, provider, kind, externalId)` is the upsert key, so re-delivering a webhook
/// updates `state` / `lastSeenAt` instead of duplicating. `state` is the provider's own word
/// (open / merged / closed ...), null for kinds that have none (a message). `url` is stored
/// only if it is http(s) (CHECK) because the UI renders it as a link.
model ExternalLink {
  id         String              @id @default(cuid())
  taskId     String              @map("task_id")
  task       Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider   IntegrationProvider
  kind       ExternalLinkKind
  externalId String              @map("external_id")
  url        String
  title      String
  state      String?
  lastSeenAt DateTime            @default(now()) @map("last_seen_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@unique([taskId, provider, kind, externalId], map: "uq_external_links_task_provider_kind_external_id")
  @@index([provider, kind, externalId], map: "idx_external_links_provider_kind_external_id")
  @@map("external_links")
}

model TaskDependency {
  id             String         @id @default(cuid())
  blockingTaskId String @map("blocking_task_id")
  blockingTask   Task           @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTaskId String @map("blocked_task_id")
  blockedTask    Task           @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  type           DependencyType @default(BLOCKS) // REQUIRES dropped — redundant with BLOCKS
  createdAt DateTime       @default(now()) @map("created_at")
  // Cycle prevention enforced at the app layer on write — not expressible
  // as a Postgres/Prisma constraint.

  @@unique([blockingTaskId, blockedTaskId])
  @@map("task_dependencies")
}

// ============================================================
// COLLABORATION
// ============================================================

// ONE model, not two (was TaskComment + ProjectComment, structurally
// identical). targetType covers Task, Project, AND Activity — engaging
// with a feed entry uses the same mechanism as commenting on a task.
// targetId is polymorphic — same Prisma limitation as Invite above, no
// native relation; resolved at the app layer via targetType branching.
model Comment {
  id     String          @id @default(cuid())
  targetType CommentableType @map("target_type")
  targetId String @map("target_id") // no @relation — polymorphic, see note above
  authorId String @map("author_id")
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String
  parentCommentId String? @map("parent_comment_id") // ONE level only — app-enforced: a comment with
                            // a parentCommentId can't itself be a parent
  parentComment   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  editedAt DateTime? @map("edited_at")

  mentions  Mention[]

  @@index([targetType, targetId])
  @@map("comments")
}

// Generalized from the old CommentReaction — now targets Comment OR Activity.
// targetId is polymorphic, same pattern as above — no native relation.
model Reaction {
  id         String        @id @default(cuid())
  targetType ReactableType @map("target_type")
  targetId String @map("target_id")
  userId String @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction   ReactionType
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([targetType, targetId, userId, reaction])
  @@index([targetType, targetId])
  @@map("reactions")
}

model Mention {
  id              String   @id @default(cuid())
  commentId String @map("comment_id")
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String @map("mentioned_user_id")
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mentions")
}

// ============================================================
// CUSTOM FIELDS & TAGS
// ============================================================

model CustomField {
  id          String    @id @default(cuid())
  workspaceId String @map("workspace_id") // workspace-wide, NOT per-project — Inbox tasks
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  key         String
  dataType FieldType @map("data_type")
  options     Json?     // choices, SELECT/MULTI_SELECT only
  order       Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  values TaskCustomValue[]

  @@unique([workspaceId, key])
  @@map("custom_fields")
}

model TaskCustomValue {
  id      String      @id @default(cuid())
  taskId String @map("task_id")
  task    Task        @relation("TaskCustomValues", fields: [taskId], references: [id], onDelete: Cascade)
  fieldId String @map("field_id")
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   Json        // VALIDATED against field.dataType (and field.options
                        // for SELECT types) at every write — non-negotiable

  // Task.customFields dropped entirely — this is the ONE mechanism now

  @@unique([taskId, fieldId])
  @@map("task_custom_values")
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // display form: whitespace-collapsed + trimmed, user's casing kept
  // step 0.8: normalized form (NFKC, whitespace-collapsed, trimmed, lower-cased)
  // - what uniqueness is enforced on, so "Bug" and "bug" are the same tag.
  // Always derived by normalizeTagName(); never accepted from a request.
  nameKey     String    @map("name_key")

  tasks TaskTag[]

  @@unique([workspaceId, nameKey], map: "uq_tags_workspace_id_name_key")
  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId String @map("tag_id")
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([taskId, tagId])
  @@map("task_tags")
}

// ============================================================
// ACTIVITY & NOTIFICATIONS
// ============================================================

// Task/Project work ONLY — account-level events go to AuditLog instead
// (CONFIRMED: kept as two separate streams, different retention/visibility)
model Activity {
  id         String             @id @default(cuid())
  channelDeliveries ChannelDelivery[]
  actorId String? @map("actor_id") // OPTIONAL — nullable for system-generated
                                  // events (e.g. scheduled due-date reminders)
                                  // that have no human actor. Found while
                                  // designing the Activity & Notifications
                                  // module — DUE_DATE_APPROACHING needed a
                                  // producer with no user to attribute it to.
  actor      User?              @relation(fields: [actorId], references: [id])
  action     ActivityAction
  visibility ActivityVisibility @default(TIMELINE) // SILENT = drives
                                  // notifications/audit only, never rendered
                                  // in the visible feed (reactions, watches)
  targetType ActivityTargetType @map("target_type") // distinctly named per the naming-collision
  targetId String @map("target_id") // fix from the graphing pass
  workspaceId String @map("workspace_id") // denormalized for fast per-workspace feed queries
  metadata   Json?               // {field, oldValue, newValue} for change events
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@map("activities")
}

// Account-level, admin-only, separate retention policy (CONFIRMED separate)
model AuditLog {
  id        String     @id @default(cuid())
  actorId String @map("actor_id")
  actor     User       @relation(fields: [actorId], references: [id])
  action    AuditAction
  accountId String @map("account_id")
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("audit_logs")
}

model Watch {
  id         String            @id @default(cuid())
  userId String @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType WatchableType @map("target_type")
  targetId String @map("target_id")
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@map("watches")
}

// Always granular at storage — grouping/digest happens at READ time in the
// client, never baked into writes (same principle as pagination elsewhere)
model Notification {
  id     String            @id @default(cuid())
  userId String @map("user_id")
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  // FIX from the graphing pass: was sourceActivityId?/sourceAuditLogId? —
  // two nullable FKs, the exact pattern we removed from Activity itself.
  // One discriminated pair instead, for consistency. Polymorphic — no
  // native Prisma relation, resolved at the app layer, same as Comment/
  // Reaction/Invite above.
  sourceType NotificationSourceType @map("source_type")
  sourceId String @map("source_id")

  readAt DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String            @id @default(cuid())
  notificationId String @map("notification_id")
  notification   Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         DeliveryStatus    @default(PENDING)
  sentAt DateTime? @map("sent_at")
  error          String?

  @@index([notificationId])
  @@map("notification_deliveries")
}

// ============================================================
// SNAP MODE (per uploaded spec — Option B, normalized)
// ============================================================

model SnapSession {
  id                String            @id @default(cuid())
  userId String @map("user_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String? @map("workspace_id") // orgId DROPPED — derivable via workspace.account

  rawInput String @map("raw_input")
  anonymizedInput String @map("anonymized_input")
  inputLength Int @map("input_length")
  wordCount Int @map("word_count")
  hasMentions Boolean @map("has_mentions")
  hasTags Boolean @map("has_tags")
  hasSymbols Boolean @map("has_symbols")
  hasEmails Boolean @map("has_emails")

  consentGiven Boolean @map("consent_given")
  dataRetentionDays Int @map("data_retention_days")

  status            SnapSessionStatus @default(PARSING)
  previousSessionId String? @map("previous_session_id") // cheap placeholder for future multi-turn
                                        // context — NOT wired up yet, no confirmed need

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clauses SnapClause[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("snap_sessions")
}

model SnapClause {
  id         String @id @default(cuid())
  sessionId String @map("session_id")
  session    SnapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clauseIndex Int @map("clause_index")
  text        String
  charStart Int @map("char_start")
  charEnd Int @map("char_end")

  // Model 1 — segmentation
  m1Confidence Float? @map("m1_confidence")
  m1TimeMs Int? @map("m1_time_ms")

  // Model 2 — action classification
  predictedAction SnapActionType? @map("predicted_action") // ENUM now, not String — was the one
  actionConfidence Float? @map("action_confidence") // real validation gap in the uploaded spec
  m2TimeMs Int? @map("m2_time_ms")

  // Model 3 — entity extraction
  extractedEntities Json? @map("extracted_entities") // validated against predictedAction's expected
  entityConfidence Float? @map("entity_confidence") // entity shape at write time (same discipline
  m3TimeMs Int? @map("m3_time_ms") // as Custom Field values)

  fuzzyMatchesUsed Json? @map("fuzzy_matches_used") // moved here from session-level — per-clause granularity

  // HITL review
  reviewStatus SnapReviewStatus @default(PENDING) @map("review_status")
  correctedAction SnapActionType? @map("corrected_action")
  correctedEntities Json? @map("corrected_entities")
  correctionType CorrectionType? @map("correction_type")
  rejectionReason String? @map("rejection_reason")
  userRating SnapRating? @map("user_rating") // ENUM now, not String

  // Execution — MUST go through TaskService/ProjectService/WorkspaceService,
  // never write Task/Project/Workspace directly (see design note in graph:
  // otherwise Snap-created items silently skip Activity logging and
  // notification fan-out — a 3rd parallel write path)
  executedAction SnapActionType? @map("executed_action")
  executedAt DateTime? @map("executed_at")
  executionError String? @map("execution_error")
  executionTimeMs Int? @map("execution_time_ms")

  // If execution created a real Task, link it (nullable — not every clause
  // creates a Task; some create Projects or Workspaces)
  createdTaskId String? @map("created_task_id")
  createdTask   Task?    @relation(fields: [createdTaskId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sessionId, clauseIndex])
  @@index([predictedAction, reviewStatus])
  @@index([correctedAction, correctionType])
  @@map("snap_clauses")
}

// ============================================================
// ENUMS
// ============================================================

enum AccountType {
  PERSONAL
  ORGANIZATION
  @@map("account_type")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  CLIENT // ProjectMember-only in practice, but shared enum for simplicity
  @@map("role")
