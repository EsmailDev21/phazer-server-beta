{
  "schemaVersion": 1,
  "meta": {
    "name": "Student workspace",
    "description": "A semester of one course: readings, assignments, an exam with a professor review step.",
    "kind": "WORKSPACE",
    "category": "education",
    "locale": "en"
  },
  "dateAnchor": { "variable": "semesterStart", "skipWeekends": true },
  "variables": [
    { "key": "course", "label": "Course name", "type": "TEXT", "default": "Introduction to Biology", "required": true },
    { "key": "semesterStart", "label": "First day of semester", "type": "DATE", "default": "2026-09-01", "required": true }
  ],
  "roles": [
    { "key": "student", "label": "Student", "suggestedAccess": "MEMBER" },
    { "key": "professor", "label": "Professor", "suggestedAccess": "VIEWER" }
  ],
  "modules": [
    { "key": "exam-prep", "label": "Exam preparation", "defaultEnabled": true, "includes": ["midterm"] },
    { "key": "labs", "label": "Lab course", "defaultEnabled": false, "includes": ["labs"] }
  ],
  "workspace": {
    "name": "{{course}}",
    "key": "STUDY",
    "icon": "graduation-cap",
    "description": "Everything for {{course}}, starting {{format(semesterStart, \"MMMM d\")}}.",
    "tags": [{ "name": "exam" }, { "name": "reading" }, { "name": "assignment" }, { "name": "lab" }],
    "customFields": [
      {
        "key": "prof-review",
        "name": "Professor review",
        "dataType": "SELECT",
        "options": ["pending", "approved", "changes requested"],
        "order": 1
      },
      { "key": "exam-weight", "name": "Exam weight (%)", "dataType": "NUMBER", "order": 2 }
    ],
    "issueTypes": [
      { "name": "Assignment", "color": "#3B82F6", "level": "STANDARD" },
      { "name": "Exam", "color": "#EF4444", "level": "EPIC" },
      { "name": "Reading", "color": "#22C55E", "level": "STANDARD" }
    ],
    "iterations": [
      { "nodeKey": "it-midterm", "kind": "MILESTONE", "name": "Midterm period", "startOffsetDays": 0, "endOffsetDays": 49 },
      { "nodeKey": "it-finals", "kind": "MILESTONE", "name": "Finals", "goal": "Everything handed in", "startOffsetDays": 50, "endOffsetDays": 100 }
    ]
  },
  "projects": [
    {
      "nodeKey": "coursework",
      "name": "{{course}}: coursework",
      "description": "Readings, assignments and the exams for {{course}}.",
      "workflow": {
        "statuses": [
          { "key": "todo", "name": "To do", "category": "TODO", "color": "#94A3B8", "isDefault": true },
          { "key": "doing", "name": "In progress", "category": "IN_PROGRESS", "color": "#3B82F6", "isDefault": true },
          { "key": "review", "name": "Professor review", "category": "IN_PROGRESS", "color": "#F59E0B" },
          { "key": "done", "name": "Done", "category": "DONE", "color": "#22C55E", "isDefault": true },
          { "key": "dropped", "name": "Dropped", "category": "DONE", "color": "#64748B", "excludeFromProgress": true }
        ],
        "transitions": [
          { "from": "todo", "to": "doing" },
          { "from": "doing", "to": "review" },
          { "from": "review", "to": "doing" },
          { "from": "review", "to": "done" }
        ],
        "enforceTransitions": false
      },
      "tasks": [
        {
          "nodeKey": "read-ch1",
          "title": "Read chapter 1 of {{course}}",
          "issueType": "Reading",
          "status": "todo",
          "priority": "MEDIUM",
          "tags": ["reading"],
          "assigneeRoles": ["student"],
          "startOffsetDays": 0,
          "dueOffsetDays": 6,
          "estimate": 2,
          "iteration": "it-midterm"
        },
        {
          "nodeKey": "essay",
          "title": "Essay: {{slug(course)}}",
          "description": "Draft, then send to the professor.\n\n- outline\n- first draft\n- final",
          "issueType": "Assignment",
          "status": "todo",
          "priority": "HIGH",
          "tags": ["assignment"],
          "customValues": { "prof-review": "pending" },
          "assigneeRoles": ["student", "professor"],
          "dueOffsetDays": 28,
          "estimate": 8,
          "iteration": "it-midterm",
          "children": [
            { "nodeKey": "essay-outline", "title": "Outline", "dueOffsetDays": 14, "estimate": 1 },
            {
              "nodeKey": "essay-draft",
              "title": "First draft",
              "dueOffsetDays": 21,
              "estimate": 4,
              "comments": [
                { "body": "Reviewed on {{format(semesterStart, \"EEE d MMM\")}}: add sources.", "authorRole": "professor" },
                { "body": "Will do." }
              ]
            }
          ],
          "attachments": ["rubric"]
        },
        {
          "nodeKey": "midterm",
          "title": "Midterm exam",
          "description": "Covers chapters 1-6.",
          "issueType": "Exam",
          "status": "todo",
          "priority": "URGENT",
          "tags": ["exam"],
          "customValues": { "prof-review": "pending", "exam-weight": 30 },
          "assigneeRoles": ["student"],
          "dueOffsetDays": 49,
          "iteration": "it-midterm",
          "children": [
            { "nodeKey": "midterm-notes", "title": "Review lecture notes", "tags": ["exam"], "dueOffsetDays": 42 },
            {
              "nodeKey": "midterm-practice",
              "title": "Practice problems",
              "tags": ["exam"],
              "dueOffsetDays": 46,
              "children": [
                { "nodeKey": "midterm-past-paper", "title": "Past paper, last year", "tags": ["exam"], "dueOffsetDays": 47 }
              ]
            }
          ]
        },
        {
          "nodeKey": "final-exam",
          "title": "Final exam",
          "issueType": "Exam",
          "tags": ["exam"],
          "customValues": { "exam-weight": 50 },
          "dueOffsetDays": 100,
          "iteration": "it-finals"
        }
      ],
      "dependencies": [
        { "from": "read-ch1", "to": "midterm", "type": "BLOCKS" },
        { "from": "essay-outline", "to": "essay-draft" },
        { "from": "midterm", "to": "final-exam", "type": "RELATES_TO" }
      ]
    },
    {
      "nodeKey": "labs",
      "name": "{{course}}: labs",
      "tasks": [
        { "nodeKey": "lab-1", "title": "Lab 1: microscopy", "tags": ["lab"], "dueOffsetDays": 9 },
        { "nodeKey": "lab-2", "title": "Lab 2: cell division", "tags": ["lab"], "dueOffsetDays": 23 }
      ]
    }
  ],
  "assets": [
    {
      "key": "rubric",
      "fileName": "essay-rubric.pdf",
      "mimeType": "application/pdf",
      "sizeBytes": 48211,
      "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
    }
  ]
}
